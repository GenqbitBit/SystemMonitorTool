<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base navigation tab -->
    <Style Selector="ToggleButton.nav-tab">
        <Setter Property="Background" Value="{DynamicResource NavTabBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource WindowBorderBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="7,0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="ZIndex" Value="10"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="ToggleButton.nav-tab /template/ ContentPresenter">
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <!-- Hover -->
    <Style Selector="ToggleButton.nav-tab:pointerover">
        <Setter Property="Background" Value="{DynamicResource NavTabHoverBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelAccentBorderBrush}"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="ToggleButton.nav-tab:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NavTabHoverBackground}"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <!-- Checked / active -->
    <Style Selector="ToggleButton.nav-tab:checked">
        <Setter Property="Background" Value="{DynamicResource NavTabActiveBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelAccentBorderBrush}"/>
        <Setter Property="BorderThickness" Value="2,2,2,3"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="ToggleButton.nav-tab:checked /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NavTabActiveBackground}"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <!-- Checked + Hover -->
    <Style Selector="ToggleButton.nav-tab:checked:pointerover">
        <Setter Property="Background" Value="{DynamicResource NavTabActiveBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelAccentBorderBrush}"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="ToggleButton.nav-tab:checked:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NavTabActiveBackground}"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>

</Styles>