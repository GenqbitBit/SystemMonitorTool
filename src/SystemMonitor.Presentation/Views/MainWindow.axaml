<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SystemMonitor.Presentation.ViewModels"
        xmlns:panels="using:SystemMonitor.Presentation.Views.PanelsAndTemplates"
        xmlns:views="using:SystemMonitor.Presentation.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:debug="using:SystemMonitor.Presentation.Debugging"
        mc:Ignorable="d"
        d:DesignWidth="1080"
        d:DesignHeight="1500"
        x:Class="SystemMonitor.Presentation.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="SystemMonitor.Presentation">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <!-- One viewport, one scrollbar: the whole dashboard scrolls as a
         single page. At full window height nothing scrolls at all. -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid ColumnDefinitions="*,Auto">

            <!-- Left column: the monitor surface, row by row -->
            <StackPanel Grid.Column="0" Orientation="Vertical" Margin="16" Spacing="16" HorizontalAlignment="Stretch">

                <!-- row 0: hardware info panels -->
                <Border HorizontalAlignment="Stretch">
                    <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Margin="12"><panels:CategoryMetricsView Metrics="{Binding Metrics}" CategoryLabel="CPU" /></Border>
                        <Border Margin="12"><panels:CategoryMetricsView Metrics="{Binding Metrics}" CategoryLabel="Motherboard" /></Border>
                        <Border Margin="12"><panels:CategoryMetricsView Metrics="{Binding Metrics}" CategoryLabel="Memory" /></Border>
                        <Border Margin="12"><panels:CategoryMetricsView Metrics="{Binding Metrics}" CategoryLabel="Disk" /></Border>
                        <Border Margin="12"><panels:CategoryMetricsView Metrics="{Binding Metrics}" CategoryLabel="Network" /></Border>
                        <Border Margin="12"><panels:CategoryMetricsView Metrics="{Binding Metrics}" CategoryLabel="OS" /></Border>
                        <Border Margin="12"
                            HorizontalAlignment="Center"
                            debug:DebugBorder.IsEnabled="False"
                            Classes="feature" BorderBrush="Gray" BorderThickness="1">
                            <panels:ProcessesView Processes="{Binding TopProcesses}" />
                        </Border>
                    </WrapPanel>
                </Border>

                <!-- row 1: all graphs merged into a single row (cpu, memory, gpu, network) -->
                <Border HorizontalAlignment="Stretch">
                    <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                        <Border Margin="12" debug:DebugBorder.IsEnabled="True">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <panels:CategoryMetricsView Metrics="{Binding Metrics}" CategoryLabel="CPU" MetricId="cpu.usage" ShowLabel="True"/>
                                <panels:MetricGraphView
                                    Metrics="{Binding Metrics}"
                                    HistoryStore="{Binding HistoryStore}"
                                    MetricId="cpu.usage"
                                    FixedMinValue="0"
                                    FixedMaxValue="100"
                                    Width="350" Height="200">
                                    <panels:MetricGraphView.ContentRenderer>
                                        <panels:BlockAreaGraphRenderer
                                            TopColor="#8051DE" BottomColor="#3008E0"
                                            BandCount="4"
                                            BlockWidth="15" BlockGap="1"/>
                                    </panels:MetricGraphView.ContentRenderer>
                                </panels:MetricGraphView>
                            </StackPanel>
                        </Border>

                        <Border Margin="12" debug:DebugBorder.IsEnabled="True">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <panels:CategoryMetricsView Metrics="{Binding Metrics}" CategoryLabel="Memory" MetricId="memory.usage" ShowLabel="True"/>
                                <panels:MetricGraphView
                                    Metrics="{Binding Metrics}"
                                    HistoryStore="{Binding HistoryStore}"
                                    MetricId="memory.usage"
                                    FixedMinValue="0"
                                    FixedMaxValue="100"
                                    Width="350" Height="200">
                                    <panels:MetricGraphView.ContentRenderer>
                                        <panels:BrailleAreaGraphRenderer
                                            CurveTopColor="Black" CurveBottomColor="#FEFFFE"
                                            AreaTopColor="#D14DEE" AreaBottomColor="#1234CE"
                                            BandCount="5"
                                            CellWidth="5" CellHeight="10"/>
                                    </panels:MetricGraphView.ContentRenderer>
                                </panels:MetricGraphView>
                            </StackPanel>
                        </Border>

                        <Border Margin="12" debug:DebugBorder.IsEnabled="True">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <panels:CategoryMetricsView Metrics="{Binding Metrics}" CategoryLabel="Dedicated GPU" MetricId="{Binding DedicatedGpuMetricId}" ShowLabel="True"/>
                                <panels:MetricGraphView
                                    Metrics="{Binding Metrics}"
                                    HistoryStore="{Binding HistoryStore}"
                                    MetricId="{Binding DedicatedGpuMetricId}"
                                    FixedMinValue="0"
                                    FixedMaxValue="100"
                                    LineBrush="#4000FF"
                                    Width="300" Height="100" />
                            </StackPanel>
                        </Border>

                        <Border Margin="12" debug:DebugBorder.IsEnabled="True">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <panels:CategoryMetricsView Metrics="{Binding Metrics}" CategoryLabel="Integrated GPU" MetricId="{Binding IntegratedGpuMetricId}" ShowLabel="True"/>
                                <panels:MetricGraphView
                                    Metrics="{Binding Metrics}"
                                    HistoryStore="{Binding HistoryStore}"
                                    MetricId="{Binding IntegratedGpuMetricId}"
                                    FixedMinValue="0"
                                    FixedMaxValue="100"
                                    LineBrush="#F01149"
                                    Width="300" Height="100" />
                            </StackPanel>
                        </Border>

                        <Border Margin="12" debug:DebugBorder.IsEnabled="True">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <panels:CategoryMetricsView Metrics="{Binding Metrics}" CategoryLabel="Network" MetricId="network.upload" />
                                <panels:MetricGraphView
                                    Metrics="{Binding Metrics}"
                                    HistoryStore="{Binding HistoryStore}"
                                    MetricId="network.upload"
                                    LineBrush="#FF9100"
                                    Width="170" Height="110" />
                            </StackPanel>
                        </Border>

                        <Border Margin="12" debug:DebugBorder.IsEnabled="True">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <panels:CategoryMetricsView Metrics="{Binding Metrics}" CategoryLabel="Network" MetricId="network.download" />
                                <panels:MetricGraphView
                                    Metrics="{Binding Metrics}"
                                    HistoryStore="{Binding HistoryStore}"
                                    MetricId="network.download"
                                    LineBrush="#E90DD3"
                                    Width="170" Height="110" />
                            </StackPanel>
                        </Border>

                    </WrapPanel>
                </Border>


            </StackPanel>

            <!-- Right column: this table, hugging its content -->
            <views:MetricsTableView Grid.Column="1"
                                DataContext="{Binding MetricsTable}"
                                Width="500"
                                Margin="0,16,16,16"
                                VerticalAlignment="Top" />
                    </Grid>
    </ScrollViewer>
</Window>