<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SystemMonitor.Presentation.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="SystemMonitor.Presentation.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="SystemMonitor.Presentation">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

        <StackPanel HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8">
                <TextBlock Text="{Binding CpuUsage, StringFormat=Cpu: {0:F0}%}"
                        FontFamily="JetBrains Mono"
                        FontSize="24" />
                <TextBlock Text="{Binding MemoryUsageDisplay}"
                        FontFamily="JetBrains Mono"
                        FontSize="24" />
                <TextBlock Text="{Binding DiskUsageDisplay}"
                        FontFamily="JetBrains Mono"
                        FontSize="20" />
                <TextBlock Text="{Binding NetworkUsageDisplay}"
                        FontFamily="JetBrains Mono"
                        FontSize="24" />
        </StackPanel>

</Window>