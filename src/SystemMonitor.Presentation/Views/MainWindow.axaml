<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SystemMonitor.Presentation.ViewModels"
        xmlns:panels="using:SystemMonitor.Presentation.Views.PanelsAndTemplates"
        xmlns:views="using:SystemMonitor.Presentation.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:debug="using:SystemMonitor.Presentation.Debugging"
        mc:Ignorable="d"
        x:Class="SystemMonitor.Presentation.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/pixelmonitor.png"
        Title="MainUI"
        d:DesignWidth="850"
        d:DesignHeight="550"
        Width="850"
        Height="550"
        MinWidth="850"
        MinHeight="550">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>


    <!-- Root -->
    <Grid RowDefinitions="96*,4*"
        RowSpacing="2"
       Margin="5,10,5,5">

        <!-- Grid0 (contents) -->
        <Border Grid.Row="0"
                BorderBrush="White"
                BorderThickness="1"
                CornerRadius="10">
            
            <Grid Margin="0">
                
                <!-- Actual Content -->
                <Grid
                Margin="10">

                </Grid>

                <TextBlock Text="Title"
                    Grid.Column="1"
                    Background="Black"
                    Padding="7,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="10,-5,0,0"
                    FontSize="11"/>
            </Grid>

            
        </Border>

        <!-- Grid1 Panel (few txt) -->
        <Panel Grid.Row="1">
            <!--Container-->
            <Grid ColumnDefinitions="70*,30*"
                Margin="10,0,25,0">

            <TextBlock Grid.Column="0" 
            FontSize="12"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Text="Currenty on Development | https://github.com/GenqbitBit/SystemMonitorTool"/>

            <TextBlock Grid.Column="1" 
            FontSize="12"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Text="Test UI"/>

            </Grid>
        </Panel>

    </Grid>
    <!-- Root -->

</Window>
