<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:SystemMonitor.Domain.Models"
             xmlns:views="using:SystemMonitor.Presentation.Views.PanelsAndTemplates"
             x:Class="SystemMonitor.Presentation.Views.PanelsAndTemplates.CpuProcessesView">

    <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Top" Spacing="4">

        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=views:CpuProcessesView}}"
            FontSize="11"
            Opacity="0.6"
            HorizontalAlignment="Center" />

        <Grid ColumnDefinitions="*,Auto" Margin="2,0,2,2">
            <TextBlock Grid.Column="0" Text="PROCESS" FontSize="9" FontWeight="SemiBold" Opacity="0.5" />
            <TextBlock Grid.Column="1" Text="CPU"     FontSize="9" FontWeight="SemiBold" Opacity="0.5" HorizontalAlignment="Right" />
        </Grid>

        <Rectangle Height="1" Fill="Gray" Opacity="0.25" Margin="2,0,2,2" />

        <ItemsControl ItemsSource="{Binding Processes, RelativeSource={RelativeSource AncestorType=views:CpuProcessesView}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:ProcessInfo">
                    <Grid ColumnDefinitions="*,Auto" Margin="2,1">
                        <TextBlock Grid.Column="0"
                                Text="{Binding Name}"
                                FontSize="10"
                                TextTrimming="CharacterEllipsis"
                                ToolTip.Tip="{Binding Name}" />

                        <TextBlock Grid.Column="1"
                                FontSize="11"
                                Margin="8,0,0,0"
                                HorizontalAlignment="Right">
                            <Run Text="{Binding CpuPercent}" Foreground="{DynamicResource MetricValueBrush}" />
                            <Run Text="%" Foreground="{DynamicResource MetricValueBrush}" />
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </StackPanel>

</UserControl>