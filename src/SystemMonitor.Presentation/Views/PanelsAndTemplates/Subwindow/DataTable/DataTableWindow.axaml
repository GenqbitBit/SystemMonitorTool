<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SystemMonitor.Presentation.ViewModels"
        xmlns:views="using:SystemMonitor.Presentation.Views"
        x:Class="SystemMonitor.Presentation.Views.Subwindows.DataTable.DataTableWindow"
        x:DataType="vm:MetricsTableViewModel"
        Title="Data Table"
        Width="620" Height="560"
        MinWidth="620" MinHeight="560"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <views:MetricsTableView/>
    </ScrollViewer>
</Window>