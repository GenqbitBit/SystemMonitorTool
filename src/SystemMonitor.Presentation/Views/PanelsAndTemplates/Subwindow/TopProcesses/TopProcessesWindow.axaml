<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SystemMonitor.Presentation.ViewModels"
        xmlns:panels="using:SystemMonitor.Presentation.Views.PanelsAndTemplates"
        x:Class="SystemMonitor.Presentation.Views.Subwindows.TopProcesses.TopProcessesWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Top Processes"
        Width="500" Height="600"
        MinWidth="400" MinHeight="400"
        WindowStartupLocation="CenterOwner">
    <ScrollViewer>
        <StackPanel Spacing="12" Margin="10">
            <panels:ProcessesView Title="Top CPU Processes" Processes="{Binding TopCpuProcesses}" />
            <panels:ProcessesView Title="Top Memory Processes" Processes="{Binding TopMemoryProcesses}" />
        </StackPanel>
    </ScrollViewer>
</Window>