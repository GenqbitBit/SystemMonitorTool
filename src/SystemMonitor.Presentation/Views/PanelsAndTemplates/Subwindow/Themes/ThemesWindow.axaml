<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SystemMonitor.Presentation.ViewModels"
        xmlns:panels="using:SystemMonitor.Presentation.Views.Subwindows.Themes"
        x:Class="SystemMonitor.Presentation.Views.Subwindows.Themes.ThemesWindow"
        x:DataType="vm:ThemesPanelViewModel"
        Title="Themes"
        Width="650" Height="450"
        MinWidth="650" MinHeight="450"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <panels:ThemesPanel/>
</Window>