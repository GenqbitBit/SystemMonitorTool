<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SystemMonitor.Presentation.ViewModels"
             xmlns:theming="using:SystemMonitor.Domain.Models.Theming"
             x:Class="SystemMonitor.Presentation.Views.Subwindows.Themes.ThemesPanel"
             x:DataType="vm:ThemesPanelViewModel"
             Background="Transparent">

    <UserControl.Styles>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PanelAccentBorderBrush}"/>
            <Setter Property="Opacity" Value="0.15"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PanelAccentBorderBrush}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="ListBoxItem:selected TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Styles>

    <Border BorderBrush="{DynamicResource PanelAccentBorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Margin="10"
            Padding="14,12">

        <DockPanel>

            <TextBlock DockPanel.Dock="Top"
                       Text="Select a theme"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="{DynamicResource MetricValueBrush}"
                       Margin="0,0,0,12"/>

            <ListBox ItemsSource="{Binding AvailableThemes}"
                     SelectedItem="{Binding SelectedTheme}"
                     Background="Transparent"
                     BorderThickness="0">

                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="theming:ThemeDefinition">
                        <Border BorderBrush="{DynamicResource SeparatorBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="4,6">
                            <TextBlock Text="{Binding DisplayName}"
                                       FontSize="11"
                                       Foreground="{DynamicResource MetricValueBrush}"/>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>

        </DockPanel>
    </Border>

</UserControl>