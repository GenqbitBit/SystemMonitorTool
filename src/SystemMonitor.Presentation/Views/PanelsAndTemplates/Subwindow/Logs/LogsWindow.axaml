<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SystemMonitor.Presentation.ViewModels"
        xmlns:panels="using:SystemMonitor.Presentation.Views.Subwindows.Logs"
        x:Class="SystemMonitor.Presentation.Views.Subwindows.Logs.LogsWindow"
        x:DataType="vm:LogsPanelViewModel"
        Title="Logs"
        Width="760" Height="350"
        MinWidth="700" MinHeight="200"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <panels:LogsPanel/>
</Window>