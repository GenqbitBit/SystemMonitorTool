<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SystemMonitor.Presentation.ViewModels"
             x:Class="SystemMonitor.Presentation.Views.Subwindows.Logs.LogsPanel"
             x:DataType="vm:LogsPanelViewModel"
             Background="Transparent">

    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
    </UserControl.Styles>

    <Border BorderBrush="{DynamicResource PanelAccentBorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Margin="10"
            Padding="14,12">

        <DockPanel>

            <!-- Toolbar -->
            <StackPanel DockPanel.Dock="Top"
                        Orientation="Horizontal"
                        Spacing="8"
                        Margin="0,0,0,12">

                <Button Content="⟳ Refresh"
                        Command="{Binding RefreshCommand}"
                        FontSize="10"
                        Foreground="{DynamicResource MetricValueBrush}"/>

                <Button Content="Delete Logs"
                        Command="{Binding DeleteLogsCommand}"
                        FontSize="10"
                        Foreground="White"
                        Background="{DynamicResource CriticalBrush}"
                        BorderThickness="0"/>
            </StackPanel>

            <!-- Column headers -->
            <Border DockPanel.Dock="Top"
                    BorderBrush="{DynamicResource PanelAccentBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="6,0,6,8"
                    Margin="0,0,0,4">
                <Grid ColumnDefinitions="150,120,*">
                    <TextBlock Grid.Column="0" Text="TIMESTAMP" FontSize="10" FontWeight="Bold" Opacity="0.6"/>
                    <TextBlock Grid.Column="1" Text="TYPE"      FontSize="10" FontWeight="Bold" Opacity="0.6"/>
                    <TextBlock Grid.Column="2" Text="MESSAGE"   FontSize="10" FontWeight="Bold" Opacity="0.6"/>
                </Grid>
            </Border>

            <ListBox ItemsSource="{Binding Entries}"
                     Background="Transparent"
                     BorderThickness="0">

                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="6,7"/>
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource PanelAccentBorderBrush}"/>
                        <Setter Property="Opacity" Value="0.15"/>
                    </Style>
                </ListBox.Styles>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource SeparatorBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="150,120,*" Margin="0,0,0,6">

                                <TextBlock Grid.Column="0"
                                           Text="{Binding Timestamp, StringFormat='{}{0:M/d/yyyy h:mm tt}'}"
                                           FontSize="10"
                                           Foreground="{DynamicResource MetricValueBrush}"/>

                                <Border Grid.Column="1"
                                        Background="{DynamicResource PanelAccentBorderBrush}"
                                        Opacity="0.85"
                                        CornerRadius="10"
                                        Padding="8,2"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Type}"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               Foreground="White"/>
                                </Border>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding Message}"
                                           FontSize="10"
                                           Foreground="{DynamicResource MetricValueBrush}"
                                           TextWrapping="Wrap"/>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>

        </DockPanel>
    </Border>

</UserControl>
