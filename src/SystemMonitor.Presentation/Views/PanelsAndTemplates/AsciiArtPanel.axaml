<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panels="using:SystemMonitor.Presentation.Views.PanelsAndTemplates"
             x:Class="SystemMonitor.Presentation.Views.PanelsAndTemplates.AsciiArtPanel"
             x:DataType="panels:AsciiArtPanelViewModel">

  <Panel HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="False">
    <panels:AsciiArtVisual x:Name="ArtVisual"
                          Art="{Binding CurrentArt}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          RenderTransformOrigin="0.5,0.5"
                          ClipToBounds="False">
      <panels:AsciiArtVisual.RenderTransform>
        <RotateTransform CenterX="{Binding RotationCenterX}" CenterY="{Binding RotationCenterY}"/>
      </panels:AsciiArtVisual.RenderTransform>
    </panels:AsciiArtVisual>

    <TextBlock Text="{Binding ErrorMessage}"
              Foreground="Red"
              IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
  </Panel>
</UserControl>