<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panels="using:SystemMonitor.Presentation.Views.PanelsAndTemplates"
             x:Class="SystemMonitor.Presentation.Views.PanelsAndTemplates.AsciiArtPanel"
             x:DataType="panels:AsciiArtPanelViewModel">

  <Grid RowDefinitions="Auto,*">
    <Button Grid.Row="0"
            Content="Upload Image"
            Command="{Binding UploadCommand}"
            HorizontalAlignment="Center"
            Margin="4"/>

    <Panel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="False">
      <panels:AsciiArtVisual x:Name="ArtVisual"
                            Art="{Binding CurrentArt}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RenderTransformOrigin="{Binding RotationOrigin}"
                            ClipToBounds="False">
        <panels:AsciiArtVisual.RenderTransform>
          <ScaleTransform ScaleX="1" ScaleY="1"/>
        </panels:AsciiArtVisual.RenderTransform>
      </panels:AsciiArtVisual>

      <TextBlock Text="{Binding ErrorMessage}"
                Foreground="Red"
                IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    </Panel>
  </Grid>
</UserControl>