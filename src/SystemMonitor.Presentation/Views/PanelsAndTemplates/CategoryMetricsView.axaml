<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:SystemMonitor.Domain.Models"
             xmlns:local="using:SystemMonitor.Presentation.Views.PanelsAndTemplates"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:debug="using:SystemMonitor.Presentation.Debugging"
             mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="150"
             x:Class="SystemMonitor.Presentation.Views.PanelsAndTemplates.CategoryMetricsView"
             x:CompileBindings="True"
             x:Name="Root">

    <!-- debug border -->
    <Border debug:DebugBorder.IsEnabled="True">
        <StackPanel HorizontalAlignment="{Binding #Root.ContentHorizontalAlignment}"
                    VerticalAlignment="Center"
                    MaxWidth="{Binding #Root.ContentMaxWidth}"
                    Spacing="{Binding #Root.ContentSpacing}">

            <!-- Category -->
            <TextBlock Text="{Binding #Root.CategoryLabel}"
                       FontSize="{Binding #Root.CategoryFontSize}"
                       FontFamily="{Binding #Root.ContentFontFamily, Converter={x:Static local:NullToUnsetConverter.Instance}}"
                       Opacity="{Binding #Root.CategoryOpacity}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       IsVisible="{Binding #Root.ShowCategoryHeader}" />

            <ItemsControl ItemsSource="{Binding #Root.FilteredMetrics}"
                          HorizontalAlignment="Stretch">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:MetricReading">
                        <!-- Metric row: Label and Value are separate TextBlocks (not
                             Runs) so ShowLabel/ShowValue can each be toggled
                             independently — Avalonia inlines don't support IsVisible. -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    Spacing="4">
                            <TextBlock Text="{Binding Label}"
                                       FontSize="{Binding #Root.MetricFontSize}"
                                       FontFamily="{Binding #Root.ContentFontFamily, Converter={x:Static local:NullToUnsetConverter.Instance}}"
                                       FontWeight="{Binding #Root.LabelFontWeight}"
                                       Foreground="{Binding #Root.LabelForeground, Converter={x:Static local:NullToUnsetConverter.Instance}}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding #Root.ShowLabel}" />
                            <TextBlock Text="{Binding DisplayValue}"
                                       FontSize="{Binding #Root.MetricFontSize}"
                                       FontFamily="{Binding #Root.ContentFontFamily, Converter={x:Static local:NullToUnsetConverter.Instance}}"
                                       FontWeight="{Binding #Root.ValueFontWeight}"
                                       Foreground="{Binding #Root.ValueForeground, TargetNullValue={DynamicResource MetricValueBrush}}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding #Root.ShowValue}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </Border>

</UserControl>