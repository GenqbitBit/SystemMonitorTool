<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SystemMonitor.Presentation.ViewModels"
             x:Class="SystemMonitor.Presentation.Views.PanelsAndTemplates.HardwareTreeView"
             x:DataType="vm:HardwareTreeViewModel">

    <Grid RowDefinitions="Auto,Auto,*">

        <TextBlock Grid.Row="0"
                   Text="Hardware Info"
                   FontSize="10"
                   Foreground="White"
                   Margin="4,4,0,2"/>

        <Button Grid.Row="1"
                Content="⟳ Refresh"
                FontSize="9"
                Padding="4,2"
                Margin="4,0,4,4"
                HorizontalAlignment="Stretch"
                Command="{Binding RefreshCommand}"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <TreeView ItemsSource="{Binding Roots}"
                      Background="#00CC2828"
                      BorderThickness="0">

                <TreeView.Styles>
                    <Style Selector="TreeViewItem">
                        <Setter Property="Padding" Value="2,0"/>
                        <Setter Property="MinHeight" Value="16"/>
                    </Style>
                    <Style Selector="TextBlock.leaf">
                        <Setter Property="HorizontalAlignment" Value="Right"/>
                    </Style>
                    <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
                        <Setter Property="BorderBrush" Value="White"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="CornerRadius" Value="0"/>
                    </Style>
                </TreeView.Styles>


                <TreeView.ItemTemplate>
                    <TreeDataTemplate ItemsSource="{Binding Children}">
                        <Grid ColumnDefinitions="12,*,Auto" MinHeight="16"
                            Background="#00000000"
                            Tapped="OnRowTapped" >

                            <!-- Leaf-only connector, first-child only -->
                            <Border Grid.Column="0"
                                    Classes.leaf="{Binding IsLeaf}"
                                    Classes.first-child="{Binding IsFirstChild}"
                                    BorderBrush="#00A118B6" BorderThickness="1">
                                <Border.Styles>
                                    <Style Selector="Border">
                                        <Setter Property="IsVisible" Value="False"/>
                                    </Style>
                                    <Style Selector="Border.leaf.first-child">
                                        <Setter Property="IsVisible" Value="True"/>
                                    </Style>
                                
                                </Border.Styles>

                                <Grid Width="5" Margin="-40,0,8,0">
                                    <Rectangle Width="1"
                                            Height="17"
                                            Fill="{DynamicResource MetricValueBrush}"
                                            Opacity=".8"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Margin="-5,-10,0,0"/>
                                    <Rectangle Height="1"
                                            Fill="{DynamicResource MetricValueBrush}"
                                            Opacity=".8"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Top"
                                            Margin="-5,6,2,0"/>
                                </Grid>
                            </Border>


                            <!-- Leaf-only connector -->
                            <Border Grid.Column="0"
                                BorderBrush="Transparent" BorderThickness="1">
                                    <Grid 
                                        IsVisible="{Binding IsLeaf}"
                                        Width="5" Margin="-30,0,8,0">
                                        <Rectangle Width="1"
                                                Height="14"
                                                Fill="{DynamicResource MetricValueBrush}"
                                                Opacity=".8"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Margin="-2,-1,0,0"/>
                                        <Rectangle Height="1"
                                                Fill="{DynamicResource MetricValueBrush}"
                                                Opacity="0.8"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Top"
                                                Margin="-2,12,0,0"/>
                                    </Grid>
                            
                                    
                            </Border> 
                            
                            <TextBlock Grid.Column="1"
                                Text="{Binding Name}"
                                Classes.leaf="{Binding IsLeaf}"
                                FontSize="11"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="-25,0,0,0"
                                Foreground="White"
                                TextTrimming="CharacterEllipsis"
                                MaxWidth="110"/>
                            
                        
                            <TextBlock Grid.Column="2"
                                       Text="{Binding DisplayValue}"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding IsLeaf}"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource MetricValueBrush}"
                                       Margin="4,0,7,0"/>
                        </Grid>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </ScrollViewer>
    </Grid>

</UserControl>